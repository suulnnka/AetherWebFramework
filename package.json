    "./codegen": "./src/codegen.js",
    "./runtime": "./src/runtime.js",
    "./template": "./src/template.js"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "build:examples": "node tools/compile-examples.mjs",
    "start": "node tools/serve.mjs"
  },
